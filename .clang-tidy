Checks:
    # Enable:
    - bugprone-*
    - clang-analyzer-*
    - concurrency-*
    - cppcoreguidelines-*
    - readability-*
    - performance-*,

    # Disable:
    - -readability-implicit-bool-conversion

AnalyzeTemporaryDtors: true

ExtraArgs:
    - -Wno-ignored-optimization-argument
    - -Wno-unknown-warning-option
    - -Wreturn-type
